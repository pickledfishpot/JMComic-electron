{
  "name": "jmcomic-electron",
  "version": "0.1.0",
  "description": "基于 Electron + Vue 3 + TypeScript 的桌面漫画阅读客户端",
  "author": "jpacg",
  "private": true,
  "main": "dist/electron/main.js",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:renderer": "vite",
    "dev:backend": "cd backend && .venv/bin/python -m jmcomic_backend.main --host 127.0.0.1 --port 8000 --data-dir \"$HOME/Library/Application Support/jmcomic-electron\" --reload",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "dist": "pnpm run build && pnpm run build:backend && electron-builder",
    "dist:mac": "pnpm run build && pnpm run build:backend && electron-builder --mac",
    "dist:win": "pnpm run build && pnpm run build:backend && electron-builder --win",
    "dist:linux": "pnpm run build && pnpm run build:backend && electron-builder --linux",
    "test": "pnpm run test:backend",
    "test:backend": "cd backend && .venv/bin/pytest ../tests/backend -q",
    "lint": "eslint electron renderer/src --ext .ts,.vue",
    "postinstall": "cd backend && python3 -m venv .venv && .venv/bin/pip install -e ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^35.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.10"
  },
  "dependencies": {
    "@vueuse/core": "^13.2.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
